# Gizli ayarlar şablonu.
# KURULUM: Bu dosyayı aynı klasöre ".env" adıyla kopyalayın ve değerleri doldurun.
#   .env dosyası .gitignore'dadır; ASLA commit'lemeyin.
# İsimlerdeki "__" (çift alt çizgi), appsettings'teki iç içe bölümü ifade eder:
#   Jwt__Key  ->  "Jwt": { "Key": ... }

# JWT imza anahtarı: en az 32 karakter, rastgele olmalı.
# Üretmek için (PowerShell):
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
Jwt__Key=

# Uygulama ilk açıldığında (hiç admin yoksa) oluşturulacak admin hesabı.
AdminSeed__Username=admin
AdminSeed__Email=admin@staj.local
AdminSeed__Password=
